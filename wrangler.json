{
  "name": "daily-assistant-proto",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "personal-repo.saulxj.ggff.net",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "main": "worker/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-assistant-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
