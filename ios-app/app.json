{
  "expo": {
    "name": "DailyAssistant",
    "slug": "daily-assistant",
    "scheme": "dailyassistant",
    "version": "0.9.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.blk.dailyassistant",
      "buildNumber": "5",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "小禾",
        "CFBundleDevelopmentRegion": "zh_CN",
        "CFBundleLocalizations": [
          "zh_Hans"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "apiBase": "https://personal-repo-api.saulxj.ggff.net/api"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "小禾用你的位置估算去日程地点要多久，只在你打开小禾时获取。",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "小禾需要用麦克风录下你说的话和会议，转成文字和纪要。",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "小禾需要读取你选的照片，认出里面的文字，整理成摘要和要办的事。",
          "cameraPermission": "小禾需要用相机拍下通知、票据等资料，认出里面的文字。",
          "microphonePermission": false
        }
      ]
    ]
  }
}
